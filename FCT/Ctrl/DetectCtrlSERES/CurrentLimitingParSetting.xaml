<UserControl x:Class="FCT.Ctrl.DetectCtrlSERES.CurrentLimitingParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlSERES" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0 4"/>
        </Style>
    </FrameworkElement.Resources>
    <Grid>
        <StackPanel>
            <DockPanel>
                <TextBlock Text="闭合合格值"/>
                <playctrl:DecimalTextBox x:Name="qValBox"/>
                <TextBlock Text="V"/>
                <TextBlock Text="，判断标准"/>
                <TextBlock Text="≤±"/>
                <playctrl:DecimalTextBox x:Name="meaOpenValBox"/>
                <TextBlock Text="V"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="断开判断标准"/>
                <TextBlock Text="≤"/>
                <playctrl:DecimalTextBox x:Name="meaCloseValBox"/>
                <TextBlock Text="V"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
