<UserControl x:Class="FCT.Ctrl.DetectCtrlSERES.MOSControlParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlSERES" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <!--<Style TargetType="playctrl:DecimalTextBox">
            <Setter Property="Width" Value="40"/>
        </Style>-->
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="2 0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="left">
            <Setter Property="Width" Value="220"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </FrameworkElement.Resources>
    <Grid>
        <StackPanel>
            <DockPanel>
                <TextBlock Style="{StaticResource left}" Text="充电MOS驱动电压（闭合MOS）"/>
                <playctrl:DecimalTextBox x:Name="box1"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="box2"/>
                <TextBlock Text="V"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Style="{StaticResource left}" Text="放电MOS驱动电压（闭合MOS）"/>
                <playctrl:DecimalTextBox x:Name="box3"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="box4"/>
                <TextBlock Text="V"/>
            </DockPanel>

            <DockPanel>
                <TextBlock Style="{StaticResource left}" Text="充放电MOS时P+电压（闭合MOS）"/>
                <playctrl:DecimalTextBox x:Name="box11"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="box12"/>
                <TextBlock Text="V"/>
            </DockPanel>

            <DockPanel>
                <TextBlock Style="{StaticResource left}" Text="充电MOS驱动电压（断开MOS）"/>
                <playctrl:DecimalTextBox x:Name="box5"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox  x:Name="box6"/>
                <TextBlock Text="V"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Style="{StaticResource left}" Text="放电MOS驱动电压（断开MOS）"/>
                <playctrl:DecimalTextBox x:Name="box7"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="box8"/>
                <TextBlock Text="V"/>
            </DockPanel>

            <DockPanel>
                <TextBlock Style="{StaticResource left}" Text="充放电MOS时P+电压（断开MOS）"/>
                <playctrl:DecimalTextBox x:Name="box9"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="box10"/>
                <TextBlock Text="V"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
