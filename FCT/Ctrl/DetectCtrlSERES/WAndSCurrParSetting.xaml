<UserControl x:Class="FCT.Ctrl.DetectCtrlSERES.WAndSCurrParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlSERES" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="playctrl:DecimalTextBox">
            <Setter Property="Width" Value="40"/>
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0 4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <DockPanel>
                <TextBlock Text="工作电流"/>
                <playctrl:DecimalTextBox x:Name="wStartBox"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="wEndBox"/>
                <TextBlock Text="mA"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="一级休眠电流≤"/>
                <playctrl:DecimalTextBox x:Name="s1StartBox"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="s1EndBox"/>
                <TextBlock Text="mA"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="二级休眠电流≤"/>
                <playctrl:DecimalTextBox x:Name="s2StartBox"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="s2EndBox"/>
                <TextBlock Text="mA"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
