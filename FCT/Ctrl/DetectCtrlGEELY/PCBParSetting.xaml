<UserControl x:Class="FCT.Ctrl.DetectCtrlGEELY.PCBParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlGEELY" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <StackPanel>
            <DockPanel Visibility="Collapsed">
                <TextBlock Text="PCB温度合格范围：≤"/>
                <playctrl:DecimalTextBox x:Name="pcbBox"/>
                <TextBlock Text="℃"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="判断标准：≤±"/>
                <playctrl:DecimalTextBox x:Name="pcbMeaBox"/>
                <TextBlock Text="℃"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
