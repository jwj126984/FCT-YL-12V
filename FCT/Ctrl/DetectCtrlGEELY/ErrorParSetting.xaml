<UserControl x:Class="FCT.Ctrl.DetectCtrlGEELY.ErrorParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlGEELY" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <Style TargetType="TextBlock">
            <!--<Setter Property="Width" Value="210"/>-->
        </Style>
        <Style TargetType="playctrl:DecimalTextBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0 4 0 0"/>
        </Style>
    </FrameworkElement.Resources>
    <Grid>
        <StackPanel>
            <DockPanel>
                <TextBlock Text="ErrRespBMS 故障判断标准="/>
                <playctrl:DecimalTextBox x:Name="ErrRespBMSBox"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="BattSnsrHwFltRaw 故障判断标准="/>
                <playctrl:DecimalTextBox x:Name="BattSnsrHwFltRawBox"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="BattRlyStsPrimSwtSts 故障判断标准&lt;"/>
                <playctrl:DecimalTextBox x:Name="BattRlyStsPrimSwtStsBox"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="BattHwFltStsPrim 故障判断标准="/>
                <playctrl:DecimalTextBox x:Name="BattHwFltStsPrimBox"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="BattFltStsPrim 故障判断标准="/>
                <playctrl:DecimalTextBox x:Name="BattFltStsPrimBox"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
