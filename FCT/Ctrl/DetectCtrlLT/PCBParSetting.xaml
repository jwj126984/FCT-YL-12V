<UserControl x:Class="FCT.Ctrl.DetectCtrlLT.PCBParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlLT" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        
    </FrameworkElement.Resources>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="PCB温度合格范围："/>
                <playctrl:DecimalTextBox x:Name="pcbStartBox"/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="pcbEndBox"/>
                <TextBlock Text="℃"/>
                <TextBlock Text="       补偿  "/>
                <TextBlock Text="-"/>
                <playctrl:DecimalTextBox x:Name="pcbcompBox"/>
                <TextBlock Text="℃"/>

            </DockPanel>
            <DockPanel>
                <TextBlock Text="温度判断标准：≤±"/>
                <playctrl:DecimalTextBox x:Name="pcbBox"/>
                <TextBlock Text="℃"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
