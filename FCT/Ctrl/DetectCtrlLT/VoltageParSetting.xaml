<UserControl x:Class="FCT.Ctrl.DetectCtrlLT.VoltageParSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FCT.Ctrl.DetectCtrlLT" xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl" xmlns:pconvert="clr-namespace:FCT.PConvert"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <pconvert:VolTageConvert x:Key="VOLTageConvert"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DockPanel" x:Key="item">
            <Setter Property="Margin" Value="0 4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="blockItem">
            <Setter Property="Width" Value="180"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DockPanel" x:Key="dockPanelTxt">
            
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Border" x:Key="border">
            <Setter Property="Width" Value="200"/>
        </Style>
    </FrameworkElement.Resources>
    <Grid>
        <StackPanel x:Name="panel">
            
        </StackPanel>
    </Grid>
</UserControl>
