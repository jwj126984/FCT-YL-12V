<Window x:Class="FCT.Dialog.StatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FCT.Dialog"
                mc:Ignorable="d"
        Title="统计设置" Height="180" Width="320" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <FrameworkElement.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </FrameworkElement.Resources>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0 10 80 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pass Num：" Grid.Column="0"/>
            <TextBox x:Name="passNum" Grid.Column="1" Foreground="Green" VerticalContentAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0 10 80 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fail Num：" Grid.Column="0"/>
            <TextBox x:Name="failNum" Grid.Column="1" Foreground="red" VerticalContentAlignment="Center"/>
        </Grid>
        <Button Content="确定" Grid.Row="2" HorizontalAlignment="Right" IsDefault="True" Click="OK_Click" VerticalAlignment="Center" Margin="0 0 20 0" Padding="8 4"></Button>
    </Grid>
</Window>

