<Window x:Class="FCT.Dialog.LoginNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FCT.Dialog"
        mc:Ignorable="d"
        Title="FCT" Height="550" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <FrameworkElement.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
        </Style>
    </FrameworkElement.Resources>
    <Grid>
        <Border VerticalAlignment="Top" Background="#dfdedc" Height="64">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28"  >用户登录</TextBlock>
        </Border>
        <Border Background="#cecdcb" Margin="0 64 0 0">
            <Border BorderBrush="Black" BorderThickness="1" Margin="16 16 16 16">
                <StackPanel HorizontalAlignment="Center">
                    <FrameworkElement.Resources>
                        <Style TargetType="DockPanel">
                            <Setter Property="Margin" Value="0 20"/>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Width" Value="160"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Width" Value="160"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </FrameworkElement.Resources>
                    <DockPanel>
                        <TextBlock>测试程序：</TextBlock>

                        <ComboBox x:Name="board">
                            <ComboBoxItem>lt</ComboBoxItem>
                            <ComboBoxItem>seres</ComboBoxItem>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock>用户类别：</TextBlock>
                        <TextBox x:Name="userType" IsEnabled="False"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock>用户姓名：</TextBlock>
                        <TextBox x:Name="userName" IsEnabled="False"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock>用户工号：</TextBlock>
                        <TextBox x:Name="acc" TextChanged="acc_TextChanged"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock>登录密码：</TextBlock>
                        <PasswordBox x:Name="pwd" Password="123"/>
                    </DockPanel>
                    <Grid Margin="0 20 0 0">
                        <Button HorizontalAlignment="Left" Width="80" Height="28" IsDefault="True" Click="Login_Click">确认</Button>
                        <Button HorizontalAlignment="Right" Width="80" Height="28" IsCancel="True" Click="Cancel_Click">取消</Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        
    </Grid>
</Window>
