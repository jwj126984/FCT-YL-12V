<Window x:Class="FCT.Dialog.ParSettingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FCT.Dialog" 
        xmlns:com="clr-namespace:Common;assembly=Common"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
    
        xmlns:playctrl="clr-namespace:FCT.Ctrl.PlayCtrl"
        mc:Ignorable="d"
        Title="参数设置" Height="600" Width="900" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <!-- Common Styles -->
        <Style x:Key="CommonTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="CommonTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CommonComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CommonButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource CommonButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="13"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 使用ObjectDataProvider获取枚举值 -->
        <ObjectDataProvider x:Key="SaveTimeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="com:SaveTimeEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

    </Window.Resources>

    <Grid Margin="10">
        <TabControl x:Name="tbCtrl" Style="{StaticResource TabControlStyle}">
            <TabItem Header="设备连接参数配置" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                        <DockPanel Margin="0,5">
                            <TextBlock Text="IT-6122B-USB：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxIT6122BPort" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="M3905D-USB：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxM3905DPort" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="扫码枪端口：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxGunPort" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="N8331端口：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxN8331Port" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="IT6322端口：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxIT6322Port" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="N69206H端口：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxN69206HPort" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="N36200/N36300端口：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxN36200Port" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="NXI-6400 IP：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="txtNXI6400IP" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="NXI-6400-2 IP：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="txtNXI6400IP2" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="COM继电器控制板：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxRelayPort" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="COM治具控制卡：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="cbxToolControlPort" Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <Button Content="保存" Click="SaveDevicePar_Click" 
                Style="{StaticResource SaveButtonStyle}"
                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="测试流程配置" x:Name="testDetectItem" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="用户" Style="{StaticResource CommonTextBlockStyle}" Width="auto"/>
                        <ComboBox Width="100" x:Name="users" Style="{StaticResource CommonComboBoxStyle}"
                                SelectionChanged="User_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UserName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="测试模式" Style="{StaticResource CommonTextBlockStyle}" Width="auto"/>
                        <ComboBox x:Name="testTypeCbx" Style="{StaticResource CommonComboBoxStyle}"/>
                        <DockPanel Margin="10,0">
                            <TextBlock Text="测试板号" Style="{StaticResource CommonTextBlockStyle}" Width="auto"/>
                            <TextBox x:Name="testBordBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <CheckBox x:Name="checkAll" Content="全选" Click="CheckAll_Click" 
                                Margin="10,0" VerticalAlignment="Center"/>
                        <Button Content="反选" Click="Invert_Click" 
                                Style="{StaticResource CommonButtonStyle}" Width="60"/>
                    </StackPanel>

                    <Border Margin="0,40,0,60" Background="White" BorderThickness="1" BorderBrush="#DDDDDD">
                        <ListBox x:Name="detectListBox" 
                                SelectionChanged="detect_SelectionChanged" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Item2}" 
                                                 VerticalAlignment="Center"
                                                 FontSize="13"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="border" 
                                                        Background="Transparent"
                                                        CornerRadius="3" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#2196F3"/>
                                                        
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <Button Content="保存" Click="SaveDetect_Click" 
                            Style="{StaticResource SaveButtonStyle}"
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Right"/>
                </Grid>
            </TabItem>

            <TabItem Header="测试流程参数配置" Style="{StaticResource TabItemStyle}" 
         PreviewMouseDown="TabItem_PreviewMouseDown">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CanTRTestGBStackPanel" Margin="0,10">

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 按钮容器 -->
                    <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,10">
                        <!-- 导入文件按钮 -->
                        <Button Content="导入文件" Click="ImportFile_Click" 
                    Style="{StaticResource SaveButtonStyle}"
                    Margin="0,0,10,0"/>
                        <!-- 导出文件按钮 -->
                        <Button Content="导出文件" Click="ExportFile_Click" 
                    Style="{StaticResource SaveButtonStyle}"
                    Margin="0,0,10,0"/>
                        <!-- 保存按钮 -->
                        <Button Content="保存" Click="SaveDetectPar_Click" 
                    Style="{StaticResource SaveButtonStyle}"
                                Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>



            <TabItem Header="协议参数指令设置" Style="{StaticResource TabItemStyle}">
                <Grid x:Name="UdsGrid">
                    <GroupBox>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="UdsParameterContainer" Margin="5">
                                <!-- 参数项将通过代码动态添加到这里 -->
                            </StackPanel>

                        </ScrollViewer>
                    </GroupBox>

                </Grid>
            </TabItem>

            <TabItem Header="其他参数设置" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <StackPanel Width="400" Margin="0,10">
                        <DockPanel Margin="0,5">
                            <TextBlock Text="工装编号：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="toolNumberBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="Station名称：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="stationBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="Rsc名称：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="rscBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="UserName：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="uNameBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="Mes地址：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="mesUrlBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5" Visibility="Hidden">
                            <TextBlock Text="产品名称：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <TextBox x:Name="produceNameBox" Style="{StaticResource CommonTextBoxStyle}"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock Text="数据库记录保存时间：" Style="{StaticResource CommonTextBlockStyle}"/>
                            <ComboBox x:Name="dbSaveTimeBox" 
                                      ItemsSource="{Binding Source={StaticResource SaveTimeEnum}}"
                                      Style="{StaticResource CommonComboBoxStyle}"/>
                        </DockPanel>
                        <Button Content="保存" Click="SaveOtherPar_Click" 
                                Style="{StaticResource SaveButtonStyle}"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="备份" Style="{StaticResource TabItemStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Margin="0,10">
                        <Button Content="备份" Click="Back_Click" 
                                Style="{StaticResource CommonButtonStyle}" Width="60"/>
                        <Button Content="还原" Click="Revert_Click" 
                                Style="{StaticResource CommonButtonStyle}"
                                Margin="10,0" Width="60"/>
                        <TextBlock x:Name="BackBlock" Style="{StaticResource CommonTextBlockStyle}"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
