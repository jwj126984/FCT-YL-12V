<Window x:Class="FCT.Dialog.UserSettingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FCT.Dialog"
        mc:Ignorable="d"
        Title="用户管理" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <FrameworkElement.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </FrameworkElement.Resources>
    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="身份"/>
                <ComboBox x:Name="roleCbx" SelectedIndex="0">
                    <ComboBoxItem Content="无"/>
                    <ComboBoxItem Content="管理员"/>
                    <ComboBoxItem Content="操作员"/>
                    <ComboBoxItem Content="技术员"/>
                </ComboBox>
                <TextBlock Text="账号"/>
                <TextBox x:Name="accBox"/>
                <TextBlock Text="姓名"/>
                <TextBox x:Name="nameBox"/>
                <Button Content="检索" Click="Seach_Click"/>
                <Button Content="添加" Click="Add_Click"/>
            </StackPanel>
            <DataGrid x:Name="userItemControl" CurrentCellChanged="userItemControl_CurrentCellChanged" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="身份" Binding="{Binding Role}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding UserName}"/>
                    <DataGridTextColumn Header="账号" Binding="{Binding Account}" IsReadOnly="True" Width="*"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="修改"
                                    Click="Update_Click"
                                     HorizontalContentAlignment="Center" DataContext="{Binding}" VerticalContentAlignment="Center">
                                    </Button>
                                    <Button Content="禁用"
                                            Visibility="Collapsed"
                                     Click="DisEnable_Click"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    </Button>
                                    <Button Content="重置密码" Click="ResetPwd_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
           
        </DockPanel>
    </Grid>
</Window>
